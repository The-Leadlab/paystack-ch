rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerUid() {
      return request.auth.uid;
    }

    /** Active membership: doc id = member uid, field ownerUid = workspace owner. */
    function isActiveMemberOf(workspaceOwner) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaceMembers/$(ownerUid())) &&
        get(/databases/$(database)/documents/workspaceMembers/$(ownerUid())).data.status == 'active' &&
        get(/databases/$(database)/documents/workspaceMembers/$(ownerUid())).data.ownerUid == workspaceOwner;
    }

    function canAccessOwner(dataOwner) {
      return signedIn() && (ownerUid() == dataOwner || isActiveMemberOf(dataOwner));
    }

    function canWriteOwner(dataOwner) {
      return signedIn() && (
        ownerUid() == dataOwner ||
        (
          isActiveMemberOf(dataOwner) &&
          get(/databases/$(database)/documents/workspaceMembers/$(ownerUid())).data.role in ['editor', 'owner']
        )
      );
    }

    function resourceOwnedByUser() {
      return signedIn() && (
        canAccessOwner(resource.data.restaurantId) ||
        canAccessOwner(resource.data.restaurant_id) ||
        canAccessOwner(resource.data.userId) ||
        canAccessOwner(resource.data.uid)
      );
    }

    function createOwnedByUser() {
      return signedIn() && (
        canWriteOwner(request.resource.data.restaurantId) ||
        canWriteOwner(request.resource.data.restaurant_id) ||
        canWriteOwner(request.resource.data.userId) ||
        canWriteOwner(request.resource.data.uid)
      );
    }

    function resourceSessionOwnedByUser() {
      return signedIn() &&
        resource.data.session_id is string &&
        exists(/databases/$(database)/documents/sessions/$(resource.data.session_id)) &&
        (
          canAccessOwner(get(/databases/$(database)/documents/sessions/$(resource.data.session_id)).data.restaurantId) ||
          canAccessOwner(get(/databases/$(database)/documents/sessions/$(resource.data.session_id)).data.restaurant_id)
        );
    }

    function createSessionOwnedByUser() {
      return signedIn() &&
        request.resource.data.session_id is string &&
        exists(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)) &&
        (
          canWriteOwner(get(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)).data.restaurantId) ||
          canWriteOwner(get(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)).data.restaurant_id)
        );
    }

    match /sessions/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    match /documents/{id} {
      allow read: if resourceOwnedByUser() || resourceSessionOwnedByUser();
      allow update, delete: if (resourceOwnedByUser() || resourceSessionOwnedByUser()) && (
        canWriteOwner(resource.data.restaurantId) ||
        canWriteOwner(resource.data.restaurant_id) ||
        canWriteOwner(resource.data.userId) ||
        canWriteOwner(resource.data.uid)
      );
      allow create: if createOwnedByUser() || createSessionOwnedByUser();
    }

    match /income/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    match /expenses/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    match /pos_readings/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    match /employees/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    /** Ali feature lab — pre-production competitor features (promote to /app when ready). */
    match /ali_lab_budgets/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_bills/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_goals/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_rules/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_holdings/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_members/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_splits/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /ali_lab_offline_queue/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    /** Shared personal finance ledger (household / team). */
    match /personal_transactions/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }
    match /personal_imports/{id} {
      allow read: if resourceOwnedByUser();
      allow update, delete: if resourceOwnedByUser() && (
        canWriteOwner(resource.data.restaurantId) || canWriteOwner(resource.data.restaurant_id)
      );
      allow create: if createOwnedByUser();
    }

    /**
     * Membership docs are written by Admin SDK only (invite accept).
     * Members may read their own membership doc for client WorkspaceContext.
     * Use `get` (not `read`) so missing docs still allow owners to listen —
     * `resource.data` on a non-existent doc fails the whole rule otherwise.
     */
    match /workspaceMembers/{memberUid} {
      allow get: if signedIn() && memberUid == ownerUid();
      allow list: if signedIn() && resource.data.ownerUid == ownerUid();
      allow write: if false;
    }

    match /workspaceInvites/{inviteId} {
      allow read, write: if false;
    }

    /**
     * Billing profile for the signed-in user (Option B: client writes after server-verified Stripe link).
     * Stripe + email are validated on the server before the client receives billing fields to merge.
     * Owner + active workspace members may read the owner's plan/usage for shared entitlements.
     */
    match /users/{userId} {
      allow read: if signedIn() && (
        userId == ownerUid() ||
        isActiveMemberOf(userId)
      );
      allow create, update: if signedIn() && userId == ownerUid();
      allow delete: if false;
    }

    match /pendingStripeCheckouts/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
